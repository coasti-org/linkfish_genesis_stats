// workspace that you can open in vscode to get work on the project quickly.
// consider installing the dbt power user extension:
// https://github.com/AltimateAI/vscode-dbt-power-user

{
    "folders": [
        {
            "path": ".."
        }
    ],
    "settings": {
        // tell dbt power user and vscode where the .env file lives,
        // and which python interpreter to use
        "python.envFile": "${workspaceFolder}/config/.env",
        "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/Scripts/python",
        "python.terminal.activateEnvironment": true,
        "python.terminal.activateEnvInCurrentTerminal": true,

        // some sensible dbt power user settings
        "dbt.queryLimit": 500,
        "dbt.enableNewLineagePanel": true,
        "dbt.lineage.defaultExpansion": 2,
        "dbt.enableCollaboration": false,
        "dbt.enableNotebooks": false,
        "dbt.installDepsOnProjectInitialization": false,

        // general settings, opinionated defaults
        "editor.formatOnSave": false,
        "files.associations": {
            ".env*": "env",
            ".credentials*": "env"
        },
        "github.copilot.enable": {
            "*": false,
            "env": false
        },
        "[sql]": {
            "editor.detectIndentation": false,
            "editor.insertSpaces": false,
            "editor.tabSize": 4,
            "editor.indentSize": 4
        }
    }
}
