
# Basis-Ordner des Produkts
LFGS_BASE_DIR="{{ _copier_conf.dst_path }}"

# DBT benötigt ein paar Variablen, va. da wir Einstellungen wie die profiles.yml
# gruppieren wollen, und `config` kein Standard Pfad ist, den DBT durchsucht.
DBT_PROFILES_DIR="${LFGS_BASE_DIR}/config/"
DBT_PROJECT_DIR="${LFGS_BASE_DIR}/dbt/"
DBT_PROFILE="{{ dbt_profile }}"

# DuckDB für ETL, von DBT via config/profiles.yml referenziert
LFGS_DUCKDB_ETL_PATH="{{ duckdb_etl_path }}"

# DuckDB für Superset, von python/orchestration.py kopiert
LFGS_DUCKDB_FRONTEND_PATH="{{ duckdb_frontend_path }}"

# Ingestion: Download via Pystatis
PYSTATIS_GENESIS_API_USERNAME="{{ pystatis_genesis_api_username }}"
PYSTATIS_GENESIS_API_PASSWORD="{{ pystatis_genesis_api_password }}"
PYSTATIS_REGIO_API_USERNAME="{{ pystatis_regio_api_username }}"
PYSTATIS_REGIO_API_PASSWORD="{{ pystatis_regio_api_password }}"

